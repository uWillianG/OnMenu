# Copie para `.env` e ajuste. Nada aqui é obrigatório em desenvolvimento —
# sem .env o projeto sobe em modo dev (DEBUG, SQLite, pagamentos em mock).

# ── Django ──────────────────────────────────────────────────────────────────
# Em produção: DJANGO_DEBUG=False + DJANGO_SECRET_KEY + DJANGO_ALLOWED_HOSTS.
DJANGO_DEBUG=True
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=onmenu.com.br,www.onmenu.com.br
# Origens confiáveis do CSRF (padrão: derivado de BASE_URL).
DJANGO_CSRF_TRUSTED_ORIGINS=https://onmenu.com.br
# URL pública: webhooks do Mercado Pago, retorno do 3DS e callback do Google.
BASE_URL=https://onmenu.com.br

# ── HTTPS ───────────────────────────────────────────────────────────────────
# Ligue quando houver nginx/Cloudflare/Render terminando o TLS na frente.
DJANGO_BEHIND_PROXY=False
# Desligue se o redirect HTTP→HTTPS já for feito pelo proxy (evita loop).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=2592000

# ── Banco ───────────────────────────────────────────────────────────────────
# Sem esta variável usa o SQLite local (db.sqlite3).
# DATABASE_URL=postgres://usuario:senha@localhost:5432/onmenu

# ── Arquivos ────────────────────────────────────────────────────────────────
# Estáticos: `manage.py collectstatic` + WhiteNoise (já vem ligado).
# Uploads (/media/): ligue só se o Django for servir os arquivos sozinho.
DJANGO_SERVE_MEDIA=False

# ── Logs e erros ────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
# Quem recebe e-mail nos erros 500 (separe por vírgula).
DJANGO_ADMINS=dono@restaurante.com.br
DJANGO_SERVER_EMAIL=

# ── Backups (manage.py backup_db) ───────────────────────────────────────────
DJANGO_BACKUP_ROOT=
DJANGO_BACKUP_KEEP=14

# ── E-mail (SMTP) ───────────────────────────────────────────────────────────
# Sem credenciais os e-mails saem no console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Mercado Pago ────────────────────────────────────────────────────────────
# Sem access token o checkout roda em mock (QR de exemplo, sem cobrança).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Obrigatório junto com o access token: sem ele os webhooks são recusados.
MERCADOPAGO_WEBHOOK_SECRET=
PIX_DEFAULT_PAYER_EMAIL=comprador@onmenu.com.br

# ── Login com Google ────────────────────────────────────────────────────────
# Redirect autorizado: BASE_URL + /accounts/entrar/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── WhatsApp (Cloud API) ────────────────────────────────────────────────────
# Sem token/phone id as mensagens só vão para o log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=55
